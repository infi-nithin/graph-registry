# Graph Registry - Environment Configuration
# Copy this file to .env and update the values with your actual configuration

# =============================================================================
# Database Configuration
# =============================================================================

# Full async database URL (optional - will be constructed from components if not provided)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://graph_registry_user:your_secure_password@localhost:5432/graph_registry

# Database connection components (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=graph_registry
DB_USER=graph_registry_user
DB_PASSWORD=your_secure_password

# Connection pooling settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =============================================================================
# Tool Registry Configuration
# =============================================================================

# Base URL for the Tool Registry service (used to validate MCP tools)
# Format: http://host:port
TOOL_REGISTRY_URL=http://localhost:8001

# =============================================================================
# Application Configuration
# =============================================================================

# Application environment: development, staging, production
APP_ENV=development

# API host and port
APP_HOST=0.0.0.0
APP_PORT=8002

# Enable auto-reload (development only)
APP_RELOAD=true
